<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- Capacitor's WebView camera capture writes the photo into the
         app-specific external files dir (…/Android/data/<pkg>/files/Pictures)
         and shares it through this FileProvider; external-path (shared
         storage root) does not cover that location. -->
    <external-files-path name="app_files" path="." />
</paths>