# Copy this file to .env and fill the required blank values.
# Never commit .env. Never put an nsec in CONTEXCGI_ALLOWED_NPUBS.

# Required bridge identity. Prefer an owner-readable key file so the secret is
# not stored in .env. Set exactly one of these two variables.
HERMES_BRIDGE_PRIVATE_KEY_FILE=
# HERMES_BRIDGE_PRIVATE_KEY=

# Required: comma/space-separated npubs or 64-character public-key hex values.
# These are the only client/device identities allowed to call the bridge.
CONTEXCGI_ALLOWED_NPUBS=

# Required operational relay set. Enter the same relays in the hermexVM app.
HERMES_BRIDGE_RELAYS=wss://relay.contextvm.org

# Private and encrypted by default. Set false only for deliberate local testing.
HERMES_BRIDGE_PUBLIC=false
HERMES_BRIDGE_REQUIRE_ENCRYPTION=true

# Hermes installation. Defaults shown as comments because dotenv does not expand $HOME.
# HERMES_HOME=/home/you/.hermes
# HERMES_AGENT_ROOT=/home/you/.hermes/hermes-agent
# HERMES_BRIDGE_DATA_ROOT=/home/you/.hermes-bridge/data
# HERMES_BRIDGE_FILE_TRANSFER_ROOT=/home/you/.hermes-bridge/files

# Local whisper.cpp voice transcription.
HERMES_WHISPER_ENABLED=false
# HERMES_WHISPER_CLI=/home/you/.local/src/whisper.cpp/build/bin/whisper-cli
# HERMES_WHISPER_MODEL=/home/you/.local/src/whisper.cpp/models/ggml-base.bin
# HERMES_FFMPEG=/usr/bin/ffmpeg
# HERMES_FFPROBE=/usr/bin/ffprobe
HERMES_TRANSCRIPTION_MAX_BYTES=8388608
HERMES_TRANSCRIPTION_MAX_DURATION_SECONDS=60
HERMES_TRANSCRIPTION_TIMEOUT_MS=180000

# Optional non-secret defaults embedded into a deployment-specific app build.
# Never define a client private key as VITE_*; Vite values are public in the APK.
VITE_HERMEX_DEFAULT_SERVER_PUBKEY=
VITE_HERMEX_DEFAULT_RELAYS=wss://relay.contextvm.org
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5176
